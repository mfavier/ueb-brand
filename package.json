{
  "name": "@ueb/brand",
  "version": "0.3.0",
  "description": "Uccle Europe Basketball — shared brand identity (design tokens, fonts, crest) for the app ecosystem.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/logos"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./logo.svg": "./src/logos/uccle-europe.svg"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": ">=3"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tailwindcss": "^3.4.11",
    "tsup": "^8.3.0",
    "typescript": "^5.5.3"
  }
}
